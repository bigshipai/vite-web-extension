{
  "manifest_version": 3,
  "name": "AdLib Pro - FB Ad Library Downloader",
  "description": "Download FB Ad Library ads picture and video resources. Support multiple languages.",

  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },

  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "downloads",
    "tabs"
  ],
  "background": {
    "service_worker": "src/pages/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "src/pages/content/index.tsx"
      ],
      "css": [
        "contentStyle.css"
      ]
    }
  ],
  "devtools_page": "src/pages/devtools/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png"
      ],
      "matches": []
    }
  ]
}
